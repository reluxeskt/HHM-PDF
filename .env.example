# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# ==================== FIREBASE CLOUD CONFIGURATION ====================
# Configuration for HHM PDF multi-device synchronization.
# Obtain these values from your Firebase Console (Project Settings -> General -> Web Apps).
# If omitted, HHM PDF runs in complete 100% Local-First Offline Mode.

VITE_FIREBASE_API_KEY="AIzaSyYourFirebaseApiKeyHere"
VITE_FIREBASE_AUTH_DOMAIN="hhm-pdf.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="hhm-pdf"
VITE_FIREBASE_STORAGE_BUCKET="hhm-pdf.appspot.com"
VITE_FIREBASE_MESSAGING_SENDER_ID="123456789012"
VITE_FIREBASE_APP_ID="1:123456789012:web:abcdef123456"
VITE_FIREBASE_DATABASE_ID="(default)"
