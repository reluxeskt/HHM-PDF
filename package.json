{
  "name": "hhm-pdf",
  "version": "1.0.0",
  "description": "HHM PDF — Professional Desktop & Web PDF Editor",
  "author": "HHM Technologies <support@hhm.tech>",
  "private": true,
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "test": "tsx tests/runAllTests.ts",
    "test:all": "tsx tests/runAllTests.ts",
    "test:text": "tsx tests/qa_text_editing.test.ts",
    "test:pdf": "tsx tests/qa_pdf_operations.test.ts",
    "test:fixtures": "tsx tests/qa_fixtures.test.ts",
    "electron:dev": "cross-env NODE_ENV=development electron .",
    "electron:build": "vite build && electron-builder --win",
    "cap:sync": "vite build && cap sync",
    "cap:open:android": "cap open android",
    "cap:build:apk": "vite build && cap sync android && cd android && ./gradlew assembleDebug",
    "cap:build:aab": "vite build && cap sync android && cd android && ./gradlew bundleRelease"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/core": "^8.5.3",
    "@capacitor/filesystem": "^8.1.5",
    "@capacitor/share": "^8.0.3",
    "@google/genai": "^2.4.0",
    "@pdf-lib/fontkit": "^1.1.1",
    "@pdfsmaller/pdf-decrypt": "^1.0.1",
    "@pdfsmaller/pdf-encrypt": "^1.2.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "docx": "^9.14.0",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "firebase": "^13.1.0",
    "idb-keyval": "^6.3.0",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "node-forge": "^1.4.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.4.299",
    "pptxgenjs": "^4.0.1",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "tesseract.js": "^7.0.0",
    "vite": "^8.3.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.3",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/node-forge": "^1.3.14",
    "@types/pako": "^2.0.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "cross-env": "^10.1.0",
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2"
  }
}
